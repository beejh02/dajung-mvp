APP_ENV=local
DATABASE_URL=sqlite:///./dajung.db
DATABASE_ECHO=false
SEED_ON_STARTUP=true
# SEED_DATA_DIR defaults to ../../shared/dummy-data from this app package.
JWT_SECRET_KEY=replace-with-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENT_ACCESS_TOKEN_EXPIRE_MINUTES=60
HANDOFF_TOKEN_EXPIRE_MINUTES=3
PASSWORD_HASH_ITERATIONS=210000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
